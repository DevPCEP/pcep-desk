# Copie para .env (cp .env.example .env) e ajuste os valores.

# Domínio público do painel (o mesmo usado no DNS).
PAINEL_DOMINIO=desk.pcepcenter.com.br
# Endereço completo, com https://, usado nos links e na API.
PAINEL_URL_PUBLICA=https://desk.pcepcenter.com.br
# Mantenha true em produção (cookies só trafegam por HTTPS).
PAINEL_COOKIE_SEGURO=true
RUST_LOG=info

# Proxy HTTPS: escolha UMA das opções abaixo.
# Opção A (servidor dedicado): o Caddy do próprio compose ocupa as portas 80/443.
COMPOSE_PROFILES=caddy
# Opção B (servidor que já tem Traefik nas portas 80/443): comente a linha
# COMPOSE_PROFILES acima e descomente as linhas abaixo. Os valores TRAEFIK_*
# vêm da configuração do Traefik existente (veja o README, seção 2.1).
#COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt

# Usuário/grupo com que o painel grava em dados/painel. Use o resultado de `id -u` e `id -g`
# do usuário que roda o docker compose.
PAINEL_UID=1000
PAINEL_GID=1000
