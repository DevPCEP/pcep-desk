# Copie para .env (cp .env.example .env) e ajuste os valores.

# Domínio público do painel (o mesmo usado no DNS).
PAINEL_DOMINIO=desk.pcepcontabil.com.br
# Endereço completo, com https://, usado nos links e na API.
PAINEL_URL_PUBLICA=https://desk.pcepcontabil.com.br
# Mantenha true em produção (cookies só trafegam por HTTPS).
PAINEL_COOKIE_SEGURO=true
RUST_LOG=info

# Usuário/grupo com que o painel grava em dados/painel. Use o resultado de `id -u` e `id -g`
# do usuário que roda o docker compose.
PAINEL_UID=1000
PAINEL_GID=1000
